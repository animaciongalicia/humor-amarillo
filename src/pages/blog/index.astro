---
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import Photo from '../../components/Photo.astro';
import { posts, fmtDate } from '../../data/blog';
import { breadcrumb } from '../../data/schema';

const schema = [breadcrumb(Astro.site!.href, 'Blog', '/blog/')];
---
<Base title="Blog: despedidas en A Coruña y Galicia" description="Ideas y guías para organizar una despedida en A Coruña: destino, marcha, cenas baile y despedidas conjuntas." schema={schema}>
  <section class="hero">
    <div class="wrap">
      <Breadcrumb current="Blog" />
      <h1>Blog: despedidas en A Coruña</h1>
      <p class="lead">Ideas prácticas para organizar tu despedida, sin vueltas.</p>
    </div>
  </section>
  <section>
    <div class="wrap grid cols-2 posts">
      {posts.map((p) => (
        <article class="card post-card">
          <a class="post-img" href={`/blog/${p.slug}/`} tabindex="-1" aria-hidden="true">
            <Photo name={p.photo} alt="" width={800} height={500} widths={[400, 800]} sizes="(min-width: 720px) 45vw, 100vw" pos={p.pos} />
          </a>
          <time datetime={p.date} class="muted small">{fmtDate(p.date)}</time>
          <h2><a href={`/blog/${p.slug}/`}>{p.h1}</a></h2>
          <p>{p.description}</p>
          <a class="btn btn-ghost" href={`/blog/${p.slug}/`}>Leer artículo</a>
        </article>
      ))}
    </div>
  </section>
</Base>
