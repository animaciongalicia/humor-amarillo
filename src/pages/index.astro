---
import Base from '../layouts/Base.astro';
import Faq from '../components/Faq.astro';
import ContactForm from '../components/ContactForm.astro';
import Photo from '../components/Photo.astro';
import { site, tel, whatsapp } from '../data/site';
import PackCard from '../components/PackCard.astro';
import { packs } from '../data/packs';
import { faqPage } from '../data/schema';

const faqs = [
  { q: '¿Cuánto cuesta Humor Amarillo en A Coruña?', a: `${site.price} € por persona. Incluye una consumición por persona y un disfraz para el homenajeado o la homenajeada.` },
  { q: '¿Cuánto dura y cuándo se hace?', a: 'La actividad dura aproximadamente 2–2,15 horas y se hace principalmente en sábado. La disponibilidad siempre es bajo consulta.' },
  { q: '¿Dónde es?', a: 'En la zona de Feáns / A Zapateira, en A Coruña.' },
  { q: '¿Se puede añadir cena y fiesta?', a: 'Sí. Tenemos nuestro propio local de cenas baile y fiesta, y se puede combinar con Humor Amarillo en el mismo plan.' },
  { q: '¿Y el hotel u otras actividades?', a: 'Se pueden añadir al pack. Hay hoteles en el centro de A Coruña desde 30 € por persona y más de 25 actividades alternativas desde 22 € por persona, como karts, paintball, barco o escape room. Cuéntanos fecha y número de personas y te lo cuadramos.' },
  { q: '¿Competimos contra otros grupos?', a: 'Depende del tamaño. Si el grupo es pequeño, puede haber competición con otros grupos. Si es grande, se organizan equipos dentro del propio grupo.' },
];

const description = `Organiza tu despedida en A Coruña: Humor Amarillo por ${site.price} € por persona, cena y fiesta en nuestro local de cenas baile, hotel y más actividades.`;
const schema = [faqPage(faqs)];
---
<Base title="Despedidas en A Coruña: Humor Amarillo, cena y fiesta" description={description} schema={schema}>
  <section class="hero hero-home">
    <div class="wrap hero-grid">
      <div>
        <p class="eyebrow">A Coruña · Solo adultos</p>
        <h1>Despedidas en A Coruña con Humor Amarillo, cena y fiesta</h1>
        <p class="lead">Circuito de 11 pruebas en Feáns / A Zapateira para despedidas de soltero y soltera, grupos de amigos y asociaciones adultas. <strong>Desde {site.price} € por persona.</strong></p>
        <div class="btn-row">
          <a class="btn btn-wa" href={whatsapp()} rel="noopener">WhatsApp</a>
          <a class="btn" href="/packs-despedida-coruna/">Ver packs con cena</a>
          <a class="btn btn-ghost hide-sm" href={tel}>Llamar</a>
        </div>
        <ul class="facts-line">
          <li><strong>{site.price} €</strong> por persona</li>
          <li><strong>2–2,15 h</strong></li>
          <li><strong>Sábados</strong></li>
        </ul>
      </div>
      <Photo name="gladiadores-barna" alt="Dos participantes con trajes de gladiador en la prueba de lucha del circuito Humor Amarillo" width={1400} height={1050} widths={[640, 1000, 1400]} sizes="(min-width: 720px) 52vw, 100vw" priority />
    </div>
  </section>

  <section>
    <div class="wrap">
      <p class="eyebrow">El circuito</p>
      <h2>Humor Amarillo: 11 pruebas para reíros juntos</h2>
      <div class="mosaic">
        <figure class="big"><Photo name="bolas-gigantes" alt="Un participante salta sobre las bolas gigantes" width={900} height={600} widths={[480, 900]} sizes="(min-width: 720px) 45vw, 100vw" /><figcaption>Y más pruebas</figcaption></figure>
        <figure><Photo name="telarana-765" alt="Un participante cruza la telaraña de cuerdas" width={600} height={450} widths={[400, 600]} sizes="(min-width: 720px) 22vw, 50vw" /><figcaption>Telaraña</figcaption></figure>
        <figure><Photo name="puente-colgante-612" alt="Una participante cruza el puente de cuerdas" width={600} height={450} widths={[400, 600]} sizes="(min-width: 720px) 22vw, 50vw" /><figcaption>Puente de Cuerdas</figcaption></figure>
        <figure><Photo name="sumos-batalla" alt="Participantes con trajes de sumo hinchables" width={600} height={450} widths={[400, 600]} sizes="(min-width: 720px) 22vw, 50vw" /><figcaption>Con Sumo Gusto</figcaption></figure>
        <figure><Photo name="pared-obstaculos-punos" alt="Un grupo atraviesa la pared con puños de espuma" width={600} height={450} widths={[400, 600]} sizes="(min-width: 720px) 22vw, 50vw" /><figcaption>Pared de Puños</figcaption></figure>
      </div>
      <div class="grid cols-3 inc">
        <p><strong>Una consumición por persona</strong> y disfraz para el homenajeado o la homenajeada.</p>
        <p><strong>Equipos o competición:</strong> contra otros grupos si sois pocos; con 11 o más, en exclusiva.</p>
        <p><strong>Un parque de un proveedor colaborador;</strong> nosotros organizamos la experiencia completa.</p>
      </div>
      <div class="btn-row"><a class="btn" href="/humor-amarillo-coruna/">Ver Humor Amarillo</a><a class="btn btn-ghost" href="/contacto/#formulario">Consultar disponibilidad</a></div>
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <h2>Una despedida completa, no solo una actividad</h2>
      <p class="lead">Un grupo que se organiza solo acaba con tres chats, cuatro presupuestos y alguien que no contesta. Aquí lo tienes junto: nos dices fecha y número de personas, y te proponemos el plan.</p>
      <ol class="ladder">
        <li><a href="/humor-amarillo-coruna/"><span class="num">1</span><strong>Humor Amarillo</strong><span class="lp">desde {site.price} €</span><span class="ld">El circuito, con consumición y disfraz.</span></a></li>
        <li><a href="/cena-fiesta-despedidas-coruna/"><span class="num">2</span><strong>Cena y fiesta</strong><span class="lp">desde 55 €</span><span class="ld">Cena baile y fiesta en nuestro local.</span></a></li>
        <li><a href="/alojamiento-despedidas-coruna/"><span class="num">3</span><strong>Hotel</strong><span class="lp">desde 30 €</span><span class="ld">En el centro, o casa rural para 8–20.</span></a></li>
        <li><a href="/otras-actividades-despedidas-coruna/"><span class="num">4</span><strong>Segunda actividad</strong><span class="lp">desde 22 €</span><span class="ld">Karts, barco, paintball, escape room…</span></a></li>
      </ol>
      <p class="muted small">Precios por persona, «desde», orientativos para 2027. Pueden variar según temporada, menú y número de personas.</p>
    </div>
  </section>

  <section>
    <div class="wrap hero-grid feature">
      <div>
        <p class="eyebrow">Después de la actividad</p>
        <h2>Cena baile y fiesta: la noche del sábado, resuelta</h2>
        <p class="lead">Nuestro local de cenas baile, para seguir con el grupo entero y sin depender de la puerta de ninguna discoteca.</p>
        <ul class="ticks">
          <li>Cena con menú, bebida y postre.</li>
          <li>Animación, espectáculo y juegos.</li>
          <li>Fiesta y sesión de DJ hasta las 3:00.</li>
          <li><strong>Con 11 o más, el homenajeado o la homenajeada no paga la cena.</strong></li>
        </ul>
        <p class="price"><span class="from-inline">desde</span>55 € <small class="muted">/ persona</small></p>
        <div class="btn-row"><a class="btn" href="/cena-fiesta-despedidas-coruna/">Ver cena y fiesta</a><a class="btn btn-ghost" href="/contacto/#formulario">Pedir precio</a></div>
      </div>
      <Photo name="_MG_9499" alt="Drag queen con peluca azul y vestido de lentejuelas actuando en una cena baile" width={1200} height={920} widths={[480, 800, 1200]} sizes="(min-width: 720px) 45vw, 100vw" pos="50% 30%" />
    </div>
  </section>

  <section class="panorama" aria-labelledby="pan-t">
    <Photo name="0viajes-por-galicia" alt="La Torre de Hércules sobre la costa de A Coruña" width={1687} height={681} widths={[640, 1100, 1687]} sizes="100vw" pos="25% 50%" />
    <div class="pan-text">
      <div class="wrap">
        <p class="eyebrow">A Coruña</p>
        <h2 id="pan-t">Tu despedida, en el centro de A Coruña</h2>
        <p>Hoteles en el centro desde 30 € por persona, con las zonas de vinos y de marcha cerca.</p>
        <div class="btn-row"><a class="btn" href="/alojamiento-despedidas-coruna/">Ver alojamiento</a><a class="btn btn-ghost" href="/otras-actividades-despedidas-coruna/">Otras actividades</a></div>
      </div>
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <h2>Packs de despedida en A Coruña</h2>
      <p class="lead">Ideas de partida, todas personalizables. Desde el plan sencillo hasta la despedida con hotel incluido.</p>
      <div class="grid cols-3 packs-home">
        {packs.slice(0, 3).map((pk) => <PackCard pack={pk} />)}
      </div>
      <div class="btn-row"><a class="btn" href="/packs-despedida-coruna/">Ver los 8 packs</a></div>
    </div>
  </section>

  <Faq items={faqs} />

  <section class="dark" id="contacto">
    <div class="wrap">
      <h2>Consulta disponibilidad para tu despedida</h2>
      <p class="lead">Dinos fecha, personas y qué te interesa. La disponibilidad es bajo consulta y la actividad se hace sobre todo en sábado: cuanto antes lo consultes, más fácil es cuadrar la fecha.</p>
      <ContactForm id="formulario" />
    </div>
  </section>
</Base>
