---
import Base from '../layouts/Base.astro';
import CtaRow from '../components/CtaRow.astro';
import Faq from '../components/Faq.astro';
import ContactForm from '../components/ContactForm.astro';
import Photo from '../components/Photo.astro';
import { site, tel, whatsapp } from '../data/site';
import PackCard from '../components/PackCard.astro';
import { packs } from '../data/packs';
import { faqPage } from '../data/schema';

const faqs = [
  { q: '¿Cuánto cuesta Humor Amarillo en A Coruña?', a: `${site.price} € por persona. Incluye una consumición por persona y un disfraz para el homenajeado o la homenajeada.` },
  { q: '¿Cuánto dura y cuándo se hace?', a: 'La actividad dura aproximadamente 2–2,15 horas y se hace principalmente en sábado. La disponibilidad siempre es bajo consulta.' },
  { q: '¿Dónde es?', a: 'En la zona de Feáns / A Zapateira, en A Coruña.' },
  { q: '¿Se puede añadir cena y fiesta?', a: 'Sí. Los 7 PC es nuestra oferta propia de cena baile y fiesta, y se puede combinar con Humor Amarillo en el mismo plan.' },
  { q: '¿Y el hotel u otras actividades?', a: 'Se pueden añadir al pack. Hay hoteles en el centro de A Coruña desde 30 € por persona y más de 25 actividades alternativas desde 22 € por persona, como karts, paintball, barco o escape room. Cuéntanos fecha y número de personas y te lo cuadramos.' },
  { q: '¿Es una actividad para adultos?', a: 'Sí, está pensada para grupos adultos: despedidas de soltero y soltera, grupos de amigos y asociaciones.' },
  { q: '¿Competimos contra otros grupos?', a: 'Depende del tamaño. Si el grupo es pequeño, puede haber competición con otros grupos. Si es grande, se organizan equipos dentro del propio grupo.' },
];

const description = `Organiza tu despedida en A Coruña: Humor Amarillo por ${site.price} € por persona, cena y fiesta en Los 7 PC, hotel y más actividades.`;
const schema = [faqPage(faqs)];
---
<Base title="Despedidas en A Coruña: Humor Amarillo, cena y fiesta" description={description} schema={schema}>
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <p class="eyebrow">Humor Amarillo · A Coruña · Solo adultos</p>
        <h1>Despedidas en A Coruña: Humor Amarillo, cena y fiesta en un solo plan</h1>
        <p class="lead">Circuito de 11 pruebas para grupos adultos en Feáns / A Zapateira. <strong>Desde {site.price} € por persona</strong>, con una consumición y disfraz para el homenajeado o la homenajeada.</p>
        <div class="btn-row">
          <a class="btn btn-wa" href={whatsapp()} rel="noopener">WhatsApp</a>
          <a class="btn" href="/packs-despedida-coruna/">Ver packs con cena y fiesta</a>
          <a class="btn btn-ghost hide-sm" href={tel}>Llamar</a>
        </div>
        <ul class="facts">
          <li><strong>{site.price} €</strong><span>por persona</span></li>
          <li><strong>2–2,15 h</strong><span>de actividad</span></li>
          <li><strong>Sábados</strong><span>principalmente</span></li>
          <li><strong>Adultos</strong><span>bajo consulta</span></li>
        </ul>
      </div>
      <Photo name="hero" alt="Grupo de amigos en el circuito de Humor Amarillo en A Coruña" priority placeholder />
    </div>
  </section>

  <section>
    <div class="wrap">
      <h2>Una despedida completa, no solo una actividad</h2>
      <p class="lead">Un grupo que se organiza solo acaba con tres chats, cuatro presupuestos y alguien que no contesta. Aquí lo tienes junto: nos dices fecha y número de personas, y te proponemos el plan.</p>
      <div class="grid cols-4">
        <article class="card">
          <span class="num">1</span>
          <h3>Humor Amarillo</h3>
          <p>El circuito Gakushi-Kai con 11 pruebas para todo el grupo.</p>
          <a class="btn btn-ghost" href="/humor-amarillo-coruna/">Ver Humor Amarillo</a>
        </article>
        <article class="card">
          <span class="num">2</span>
          <h3>Cena y fiesta</h3>
          <p>Cena baile y fiesta en Los 7 PC, nuestra oferta propia, para seguir con el grupo entero.</p>
          <a class="btn btn-ghost" href="/cena-fiesta-despedidas-coruna/">Ver cena y fiesta</a>
        </article>
        <article class="card">
          <span class="num">3</span>
          <h3>Hotel</h3>
          <p>Hoteles en el centro desde 30 € por persona, o casa rural para 8–20 personas.</p>
          <a class="btn btn-ghost" href="/alojamiento-despedidas-coruna/">Ver alojamiento</a>
        </article>
        <article class="card">
          <span class="num">4</span>
          <h3>Segunda actividad</h3>
          <p>Karts, barco, paintball, escape room, catas, spa y más, desde 22 € por persona.</p>
          <a class="btn btn-ghost" href="/otras-actividades-despedidas-coruna/">Ver actividades</a>
        </article>
      </div>
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <h2>Humor Amarillo en A Coruña: qué te llevas por {site.price} €</h2>
      <div class="grid cols-2">
        <div>
          <ul class="ticks">
            <li>Circuito Gakushi-Kai con 11 pruebas.</li>
            <li>Una consumición por persona.</li>
            <li>Disfraz para el homenajeado o la homenajeada.</li>
            <li>Competición con otros grupos si sois pocos; equipos dentro del grupo si sois muchos.</li>
          </ul>
          <p class="muted">Zona Feáns / A Zapateira. El circuito se celebra en un parque de un proveedor colaborador; nosotros organizamos la experiencia completa.</p>
          <CtaRow label="Consultar disponibilidad" wa="Hola, quiero consultar disponibilidad para Humor Amarillo en A Coruña." />
        </div>
        <div>
          <p class="eyebrow">Las pruebas</p>
          <ul class="pills">
            <li>Con Sumo Gusto</li><li>El Guantazo</li><li>Lucha de Gladiadores</li><li>Pared de Puños</li>
            <li>Telaraña</li><li>Tiro de Soga</li><li>Abraza la Seta</li><li>Puente de Cuerdas</li>
            <li>Carrera de Dragones</li><li>Rollitos de Primavera</li><li>Salto al Vacío</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <h2>Packs de despedida en A Coruña</h2>
      <p class="lead">Ideas de partida, todas personalizables. Precios por persona, «desde», orientativos para 2027; pueden variar según temporada, menú y número de asistentes.</p>
      <div class="grid cols-4">
        {packs.slice(0, 2).map((pk) => <PackCard pack={pk} />)}
        {packs.filter((p) => p.name === 'Pack Karts y fiesta' || p.name === 'Pack del Mar').map((pk) => <PackCard pack={pk} />)}
      </div>
      <div class="btn-row"><a class="btn" href="/packs-despedida-coruna/">Ver los 8 packs</a></div>
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <h2>Para quién es</h2>
      <ul class="ticks">
        <li>Despedidas de soltero y de soltera.</li>
        <li>Grupos de amigos adultos.</li>
        <li>Asociaciones y grupos adultos.</li>
      </ul>
      <p class="muted">¿Eres una empresa y buscas un plan para tu equipo? También puedes consultarlo.</p>
    </div>
  </section>

  <Faq items={faqs} />

  <section class="dark" id="contacto">
    <div class="wrap">
      <h2>Consulta disponibilidad para tu despedida</h2>
      <p class="lead">Dinos fecha, personas y qué te interesa. La disponibilidad es bajo consulta y la actividad se hace sobre todo en sábado: cuanto antes lo consultes, más fácil es cuadrar la fecha.</p>
      <ContactForm id="formulario" />
    </div>
  </section>
</Base>
