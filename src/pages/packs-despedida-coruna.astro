---
import Base from '../layouts/Base.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import Photo from '../components/Photo.astro';
import CtaRow from '../components/CtaRow.astro';
import Faq from '../components/Faq.astro';
import ContactForm from '../components/ContactForm.astro';
import PackDetail from '../components/PackDetail.astro';
import { packs } from '../data/packs';
import { site } from '../data/site';
import { faqPage, breadcrumb } from '../data/schema';

const faqs = [
  { q: '¿Cuánto cuestan los packs de despedida?', a: `Desde ${site.price} € por persona (solo Humor Amarillo). Los packs con cena, hotel o actividades extra van desde 80 € hasta 120 € por persona según el pack; el precio final depende de la temporada, el menú y el número de personas.` },
  { q: '¿Puedo montar mi propio pack?', a: 'Sí. Los packs son combinaciones de partida. Dinos qué te interesa y lo ajustamos al grupo.' },
  { q: '¿Qué pasa si somos un grupo grande?', a: 'Humor Amarillo permite organizar equipos dentro del propio grupo. Para cena, hotel y otras actividades, cuéntanos cuántos sois al pedir precio: el precio por persona se recalcula según el número de asistentes.' },
  { q: '¿La disponibilidad está garantizada?', a: 'No. La disponibilidad es siempre bajo consulta, y la actividad se hace principalmente en sábado.' },
];
const schema = [breadcrumb(Astro.site!.href, 'Packs de despedida', '/packs-despedida-coruna/'), faqPage(faqs)];
---
<Base
  title="Packs de despedida en A Coruña: actividad, cena y fiesta"
  description="8 packs de despedida en A Coruña desde 42 € por persona: Humor Amarillo, cena y fiesta, hotel, karts, barco y más. Personalizables, pide precio."
  schema={schema}
>
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
      <Breadcrumb current="Packs de despedida" />
      <h1>Packs de despedida en A Coruña</h1>
      <p class="lead">Desde {site.price} € por persona. Parte de Humor Amarillo y añade cena y fiesta, hotel u otra actividad. El precio final depende de la fecha y del número de personas.</p>
      <CtaRow label="Pedir precio" wa="Hola, quiero pedir precio de un pack de despedida en A Coruña." />
    </div>
      <Photo name="pared-obstaculos-puños" alt="Grupo de amigos superando juntos una prueba del circuito de Humor Amarillo" priority />
    </div>
  </section>

  <section>
    <div class="wrap">
      <h2>8 ideas de pack para tu despedida</h2>
      <p class="lead">Todos los packs son personalizables: se pueden cambiar actividades y cenas, y recalcular el precio según el número de personas y el menú elegido. Úsalos como punto de partida.</p>
      <div class="pack-grid">
        {packs.map((pk, i) => <PackDetail pack={pk} n={i + 1} />)}
      </div>
      <p class="muted small">Precios por persona, «desde», orientativos para 2027. Pueden variar según temporada, menú, número de asistentes y disponibilidad. Humor Amarillo ({site.price} € por persona) incluye una consumición por persona y disfraz para el homenajeado o la homenajeada.</p>
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <h2>Cómo se pide un pack</h2>
      <ol class="steps">
        <li><strong>Cuéntanos tu plan</strong>Fecha, número de personas y qué te interesa. Por WhatsApp, teléfono o formulario.</li>
        <li><strong>Ajustamos el pack</strong>Cambiamos actividades, cena o alojamiento y te damos el precio por persona según temporada y menú.</li>
        <li><strong>Reservas con un pago de garantía</strong>El porcentaje depende de los servicios contratados. Consulta las <a href="#condiciones">condiciones de reserva</a>.</li>
      </ol>
    </div>
  </section>

  <section>
    <div class="wrap grid cols-2">
      <div>
        <h2>Qué influye en el precio</h2>
        <ul class="ticks">
          <li><strong>La temporada.</strong> Los alojamientos, barcos y cenas cambian según la época.</li>
          <li><strong>El menú elegido.</strong> En cenas, hay distintas opciones y rangos de precio.</li>
          <li><strong>El número de personas.</strong> Muchas actividades piden un mínimo o permiten exclusividad con más gente.</li>
          <li><strong>El alojamiento.</strong> Hoteles en el centro o casa rural para el grupo.</li>
        </ul>
      </div>
      <div>
        <h2>Ventajas de ser 11 o más</h2>
        <ul class="ticks">
          <li>Humor Amarillo en exclusiva para vuestro grupo.</li>
          <li>El homenajeado o la homenajeada no paga la cena.</li>
          <li>Gymkana con novio o novia gratis (10 + 1).</li>
          <li>Más margen para ajustar el pack a lo que queráis.</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <h2>Monta el tuyo</h2>
      <p class="lead">Parte de Humor Amarillo y añade lo que tu grupo necesite. Mira las <a href="/otras-actividades-despedidas-coruna/">otras actividades</a>, el <a href="/cena-fiesta-despedidas-coruna/">plan de cena y fiesta</a> y el <a href="/alojamiento-despedidas-coruna/">alojamiento</a>, y pídenos precio con tu fecha y número de personas.</p>
      <CtaRow label="Pedir precio" wa="Hola, quiero pedir precio de un pack de despedida en A Coruña." />
    </div>
  </section>

  <section id="hotel-y-actividades">
    <div class="wrap grid cols-2">
      <div>
        <h2>Hotel para el grupo</h2>
        <p>Hoteles en el centro de A Coruña con habitaciones dobles y triples, desde 30 € por persona. Para el grupo que quiere casa rural, hay opciones de 8 a 20 plazas en los alrededores.</p>
        <div class="btn-row"><a class="btn btn-ghost" href="/alojamiento-despedidas-coruna/">Ver alojamiento</a></div>
      </div>
      <div>
        <h2>Una segunda actividad</h2>
        <p>Karts, paintball, barco, motos de agua, escape room, catas, spa, gymkanas y más, desde 22 € por persona.</p>
        <div class="btn-row"><a class="btn btn-ghost" href="/otras-actividades-despedidas-coruna/">Ver actividades</a></div>
      </div>
    </div>
  </section>

  <section class="band" id="condiciones">
    <div class="wrap prose">
      <h2>Condiciones de reserva</h2>
      <ol>
        <li>Se pide un pago como garantía de reserva; el porcentaje depende de los servicios contratados.</li>
        <li>Si baja el número de comensales sin previo aviso, se cobra la reserva íntegra.</li>
        <li>Una vez formalizada la reserva, queda reservado el derecho a cobrar gastos de cancelación total o parcial.</li>
        <li>No se devuelve la reserva si los cambios se producen dentro de los 7 días previos a la fecha.</li>
        <li>Las cancelaciones con menos de 48 h de antelación supondrán el cobro del 100 % de las plazas reservadas.</li>
        <li>Si cancelas o no te presentas el día de la reserva, el depósito se pierde íntegramente.</li>
      </ol>
    </div>
  </section>

  <Faq items={faqs} />

  <section class="dark">
    <div class="wrap">
      <h2>Pide precio para tu pack</h2>
      <ContactForm preselect={['Humor Amarillo', 'Cena y fiesta']} />
    </div>
  </section>
</Base>
