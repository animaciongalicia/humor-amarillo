---
import Base from '../layouts/Base.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import Faq from '../components/Faq.astro';
import { site, groupSites, whatsapp } from '../data/site';
import { breadcrumb, faqPage, orgRef } from '../data/schema';

const path = '/quienes-somos/';
const faqs = [
  { q: '¿Quién está detrás de Humor Amarillo Coruña?', a: `Esta web es del grupo Animación Galicia. La empresa titular es ${site.legalName}, con CIF ${site.cif} y sede en A Coruña.` },
  { q: '¿Cuánta experiencia tenéis?', a: 'Más de 15 años organizando despedidas, eventos y ginkanas en Galicia.' },
  { q: '¿Qué hacéis exactamente desde esta web?', a: 'Organizamos despedidas en A Coruña: Humor Amarillo, cena baile con show y fiesta, alojamiento y otras actividades, con un único contacto.' },
  { q: '¿Organizáis despedidas en otras ciudades?', a: 'Sí. El grupo tiene webs de despedidas para toda Galicia, A Coruña, Vigo y Sanxenxo, además de ginkanas y eventos de empresa.' },
];
const schema = [
  breadcrumb(Astro.site!.href, 'Quiénes somos', path),
  faqPage(faqs),
  { '@type': 'AboutPage', name: 'Quiénes somos', url: new URL(path, Astro.site).href, about: orgRef(Astro.site!.href) },
];
---
<Base title="Quiénes somos: grupo Animación Galicia" description="Humor Amarillo Coruña es una web del grupo Animación Galicia: más de 15 años organizando despedidas, eventos y ginkanas en Galicia." schema={schema}>
  <section class="hero">
    <div class="wrap">
      <Breadcrumb current="Quiénes somos" />
      <h1>Quiénes somos</h1>
      <p class="lead">Humor Amarillo Coruña es una web del <strong>grupo Animación Galicia</strong>. Llevamos más de 15 años organizando despedidas, eventos y ginkanas en Galicia.</p>
    </div>
  </section>

  <section>
    <div class="wrap grid cols-2">
      <div>
        <h2>Qué hacemos aquí</h2>
        <p>Esta web está dedicada a las despedidas en A Coruña. Juntamos en un solo plan lo que un grupo necesita: <a href="/humor-amarillo-coruna/">Humor Amarillo</a> por la tarde, <a href="/cena-fiesta-despedidas-coruna/">cena baile con show y fiesta</a> por la noche, <a href="/alojamiento-despedidas-coruna/">hotel en el centro</a> y, si queréis, <a href="/otras-actividades-despedidas-coruna/">otra actividad</a>.</p>
        <p>Un solo contacto, de principio a fin. Tú nos dices fecha y número de personas; nosotros te proponemos el plan.</p>
      </div>
      <div>
        <h2>El grupo Animación Galicia</h2>
        <p>Animación Galicia es donde empezamos. Con los años hemos creado varias webs propias, cada una con su enfoque: unas para una <strong>ciudad</strong> y otras para un <strong>tipo de actividad</strong>. Así quien busca una despedida en Vigo, una ginkana o un evento de empresa llega directamente a lo que necesita.</p>
      </div>
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <h2>Nuestras webs</h2>
      <p class="lead">Todas son del mismo grupo y las gestiona el mismo equipo.</p>
      <div class="grid group-sites">
        {groupSites.map((g) => (
          <a class="card group-site" href={g.url} target="_blank" rel="noopener">
            <h3>{g.name} <span aria-hidden="true">↗</span></h3>
            <p>{g.desc}</p>
            <span class="muted small">{g.url.replace(/^https:\/\/(www\.)?/, '').replace(/\/$/, '')}</span>
          </a>
        ))}
        <div class="card group-site current">
          <h3>Humor Amarillo Coruña</h3>
          <p>Despedidas en A Coruña: Humor Amarillo, cena baile y fiesta, hotel y actividades.</p>
          <span class="muted small">Estás aquí</span>
        </div>
      </div>
    </div>
  </section>

  <section>
    <div class="wrap grid cols-2">
      <div>
        <h2>Datos de la empresa</h2>
        <dl class="data">
          <div><dt>Titular</dt><dd>{site.legalName}</dd></div>
          <div><dt>CIF</dt><dd>{site.cif}</dd></div>
          <div><dt>Domicilio</dt><dd>{site.address.street}, {site.address.postalCode} {site.address.city}</dd></div>
          <div><dt>Teléfono y WhatsApp</dt><dd>{site.phoneDisplay}</dd></div>
          <div><dt>Email</dt><dd><a href={`mailto:${site.email}`}>{site.email}</a></dd></div>
        </dl>
      </div>
      <div>
        <h2>¿Hablamos?</h2>
        <p>Cuéntanos fecha y número de personas y te proponemos el plan.</p>
        <div class="btn-row"><a class="btn btn-wa" href={whatsapp()} rel="noopener">WhatsApp {site.phoneDisplay}</a><a class="btn btn-ghost" href="/contacto/">Contacto</a></div>
      </div>
    </div>
  </section>

  <Faq items={faqs} />
</Base>
