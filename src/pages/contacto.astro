---
import Base from '../layouts/Base.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import ContactForm from '../components/ContactForm.astro';
import { site, tel, whatsapp } from '../data/site';
import Photo from '../components/Photo.astro';
import { breadcrumb } from '../data/schema';

const schema = [
  breadcrumb(Astro.site!.href, 'Contacto', '/contacto/'),
  { '@type': 'ContactPage', url: new URL('/contacto/', Astro.site).href, name: 'Contacto', about: { '@id': new URL('/#organization', Astro.site).href } },
];
---
<Base
  title="Contacto y reservas: despedidas en A Coruña"
  description="Consulta disponibilidad y precio para tu despedida en A Coruña por WhatsApp, teléfono, email o formulario."
  schema={schema}
>
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
      <Breadcrumb current="Contacto" />
      <h1>Consulta disponibilidad para tu despedida</h1>
      <p class="lead">Escríbenos por WhatsApp, llámanos o rellena el formulario con fecha y número de personas.</p>
      <div class="btn-row">
        <a class="btn btn-wa" href={whatsapp()} rel="noopener">WhatsApp {site.phoneDisplay}</a>
        <a class="btn" href={tel}>Llamar al {site.phoneDisplay}</a>
      </div>
      </div>
      <Photo name="gladiadores-43665" alt="Dos participantes luchando sobre plataformas en el circuito de Humor Amarillo" width={1000} height={750} widths={[480, 800, 1000]} priority pos="50% 40%" />
    </div>
  </section>
  <section>
    <div class="wrap grid cols-2">
      <div>
        <h2>Formulario de consulta</h2>
        <ContactForm />
      </div>
      <div>
        <h2>Otras formas de contactar</h2>
        <dl class="data">
          <div><dt>WhatsApp</dt><dd><a href={whatsapp()} rel="noopener">{site.phoneDisplay}</a></dd></div>
          <div><dt>Teléfono</dt><dd><a href={tel}>{site.phoneDisplay}</a></dd></div>
          <div><dt>Email</dt><dd><a href={`mailto:${site.email}`}>{site.email}</a></dd></div>
          <div><dt>Actividad</dt><dd>Zona Feáns / A Zapateira, A Coruña</dd></div>
        </dl>
        <p class="muted small">Actividad para adultos. La disponibilidad siempre es bajo consulta.</p>
        <p class="small">Antes de escribir, puedes ver el precio y las pruebas de <a href="/humor-amarillo-coruna/">Humor Amarillo Coruña</a>, los <a href="/packs-despedida-coruna/">packs</a> o cómo es la <a href="/cena-fiesta-despedidas-coruna/">cena y fiesta</a>.</p>
      </div>
    </div>
  </section>
</Base>
