---
import { Image } from 'astro:assets';

interface Props {
  name: string; alt: string; priority?: boolean; width?: number; height?: number; placeholder?: boolean;
  sizes?: string; widths?: number[];
}
const {
  name, alt, priority = false, width = 1200, height = 750, placeholder = false,
  sizes = '(min-width: 720px) 50vw, 100vw', widths = [480, 800, width],
} = Astro.props;

// Busca la foto por nombre de archivo (sin extensión), ignorando mayúsculas y acentos.
const norm = (s: string) => s.normalize('NFC').toLowerCase();
const all = import.meta.glob<{ default: ImageMetadata }>('/src/assets/photos/*.{jpg,jpeg,png,webp,JPG,JPEG,PNG,WEBP}', { eager: true });
const hit = Object.entries(all).find(([p]) => norm(p.split('/').pop()!.replace(/\.[^.]+$/, '')) === norm(name));
// Hueco visible mientras faltan las fotos. Ocultar con PUBLIC_HIDE_PHOTO_SLOTS=1.
const showSlot = placeholder && !hit && !import.meta.env.PUBLIC_HIDE_PHOTO_SLOTS;
---
{hit && (
  <Image
    class="photo"
    src={hit[1].default}
    alt={alt}
    width={width}
    height={height}
    widths={widths}
    sizes={sizes}
    loading={priority ? 'eager' : 'lazy'}
    fetchpriority={priority ? 'high' : 'auto'}
    decoding={priority ? 'sync' : 'async'}
    format="webp"
  />
)}
{showSlot && <div class="photo photo-slot" role="img" aria-label={`Espacio reservado para foto: ${alt}`}><span>Foto pendiente<br /><small>{name}.jpg</small></span></div>}
