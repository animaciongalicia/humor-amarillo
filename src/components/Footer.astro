---
import { site, tel, whatsapp } from '../data/site';
import { groups } from '../data/activities';
---
<footer class="site-footer">
  <div class="wrap">
    <div class="grid">
      <div class="f-brand">
        <h2>{site.name}</h2>
        <p><a href="/">Despedidas en A Coruña</a>: Humor Amarillo, cena y fiesta, hotel y más actividades para grupos adultos.</p>
      </div>
      <div class="f-contact">
        <h2>Contacto</h2>
        <ul>
          <li><a href={whatsapp()} rel="noopener">WhatsApp {site.phoneDisplay}</a></li>
          <li><a href={tel}>Llamar al {site.phoneDisplay}</a></li>
          <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
        </ul>
      </div>
      <div>
        <h2>Humor Amarillo</h2>
        <ul>
          <li><a href="/humor-amarillo-coruna/">Humor Amarillo Coruña</a></li>
          <li><a href="/packs-despedida-coruna/">Packs de despedida</a></li>
          <li><a href="/cena-fiesta-despedidas-coruna/">Cena y fiesta</a></li>
          <li><a href="/blog/">Blog</a></li>
          <li><a href="/contacto/">Consultar disponibilidad</a></li>
        </ul>
      </div>
      <div>
        <h2>Actividades y planes</h2>
        <ul>
          {groups.map((g) => <li><a href={`/otras-actividades-despedidas-coruna/#${g.id}`}>{g.title}</a></li>)}
          <li><a href="/alojamiento-despedidas-coruna/">Alojamiento</a></li>
        </ul>
      </div>
    </div>
    <div class="f-bottom">
      <span>{site.legalName} · CIF {site.cif} · {site.address.street}, {site.address.postalCode} {site.address.city} · <a href="https://www.animaciongalicia.com/">Animación Galicia</a></span>
      <span>Actividad para adultos. Disponibilidad bajo consulta. · <a href="/aviso-legal-privacidad/">Aviso legal y privacidad</a> · <button type="button" class="linkbtn" data-cookie-settings>Cookies</button></span>
    </div>
  </div>
</footer>
